        <section id="portfolio">
            <div class="container-fluid">
                <div class="portfolio-heading">
                    <div class="section-intro" style="margin-bottom:0;">
                        <h4>Recent Work</h4>
                        <h2 style="font-family: 'Outfit', sans-serif; font-size: 2.5rem; font-weight: 800; margin-bottom: 8px;">Look at my portfolio and give me your feedback</h2>
                    </div>
                    <a href="/projects" class="btn-secondary" style="font-family: 'Space Grotesk', sans-serif; font-weight: 700; background: linear-gradient(135deg, #1d6bff 0%, #00f2fe 100%); color: #090e1f; padding: 12px 28px; border-radius: 12px; border: none; box-shadow: 0 4px 15px rgba(0, 242, 254, 0.25); display: inline-flex; align-items: center; gap: 8px;">
                        SEE ALL PROJECTS <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
                <div class="stats-grid">
                    <div class="stat-card">
                        <span>50+</span>
                        <p>Completed Project</p>
                    </div>
                    <div class="stat-card">
                        <span>94%</span>
                        <p>Positive Rating</p>
                    </div>
                </div>
                <div class="portfolio-grid">
                    <% if (projects && projects.length > 0) { %>
                        <% projects.forEach(function(p) { %>
                        <article class="portfolio-item">
                            <div class="portfolio-img-wrap">
                                <% if (p.image) { %>
                                    <img src="<%= p.image %>" onerror="this.onerror=null; <% if (p.fallback_image) { %>this.src='<%= p.fallback_image %>';<% } %>" alt="<%= p.title %>">
                                <% } else { %>
                                    <div style="min-height:260px; display:flex; align-items:center; justify-content:center; background: linear-gradient(135deg, rgba(29,107,255,.22), rgba(77,204,255,.12));">
                                        <i class="fas fa-image fa-3x" style="opacity:.6;"></i>
                                    </div>
                                <% } %>
                                
                                <!-- Hover Overlay with View Button -->
                                <div class="portfolio-overlay">
                                    <a class="btn-portfolio-view text-decoration-none" href="/projects">
                                        <i class="fas fa-search-plus"></i> View
                                    </a>
                                </div>
                            </div>
                            <div class="portfolio-info">
                                <span class="portfolio-category"><%= p.category %></span>
                                <h3 class="portfolio-title"><%= p.title %></h3>
                                <p class="portfolio-desc">
                                    <%= p.description %>
                                </p>
                                
                                <% if (p.tags && p.tags.length > 0) { %>
                                    <div class="d-flex flex-wrap gap-2 mt-auto">
                                        <% p.tags.slice(0, 3).forEach(function(tag) { 
                                            var tagLower = tag.toLowerCase();
                                            var style = "font-size: 0.72rem; padding: 5px 12px; border-radius: 8px; font-weight: 600; font-family: 'Space Grotesk', sans-serif; transition: all 0.3s ease;";
                                            if (tagLower.includes('django') || tagLower.includes('python')) {
                                                style += " background: rgba(16, 185, 129, 0.12); color: #10b981; border: 1.5px solid rgba(16, 185, 129, 0.3);";
                                            } else if (tagLower.includes('react') || tagLower.includes('tailwind') || tagLower.includes('dashboard') || tagLower.includes('control')) {
                                                style += " background: rgba(0, 242, 254, 0.12); color: #00f2fe; border: 1.5px solid rgba(0, 242, 254, 0.3);";
                                            } else if (tagLower.includes('rest') || tagLower.includes('jwt') || tagLower.includes('cors')) {
                                                style += " background: rgba(168, 85, 247, 0.12); color: #a855f7; border: 1.5px solid rgba(168, 85, 247, 0.3);";
                                            } else if (tagLower.includes('websocket') || tagLower.includes('redis') || tagLower.includes('channels') || tagLower.includes('real-time')) {
                                                style += " background: rgba(245, 158, 11, 0.12); color: #fb923c; border: 1.5px solid rgba(245, 158, 11, 0.3);";
                                            } else if (tagLower.includes('supabase') || tagLower.includes('postgres') || tagLower.includes('db')) {
                                                style += " background: rgba(62, 207, 142, 0.12); color: #3ecf8e; border: 1.5px solid rgba(62, 207, 142, 0.3);";
                                            } else if (tagLower.includes('firebase') || tagLower.includes('auth') || tagLower.includes('firestore') || tagLower.includes('secure')) {
                                                style += " background: rgba(251, 191, 36, 0.12); color: #fbbf24; border: 1.5px solid rgba(251, 191, 36, 0.3);";
                                            } else {
                                                style += " background: rgba(29, 107, 255, 0.12); color: #60a5fa; border: 1.5px solid rgba(29, 107, 255, 0.3);";
                                            }
                                        %>
                                            <span style="<%= style %>"><%= tag %></span>
                                        <% }) %>
                                    </div>
                                <% } %>
                            </div>
                        </article>
                        <% }) %>
                    <% } else { %>
                        <div class="card" style="grid-column:1/-1; text-align:center; padding:60px 30px;">
                            <p>No projects added yet. Update admin to show portfolio items.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>
