<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Usman Ahmad | Backend Web Developer</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@500;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <script src="https://unpkg.com/typed.js@2.1.0/dist/typed.umd.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --primary: #1d6bff;
            --primary-soft: rgba(29, 107, 255, 0.15);
            --background: #090e1f;
            --surface: #111a36;
            --surface-strong: #131f44;
            --text: #eaeaf0;
            --muted: #8f96aa;
            --border: rgba(29, 107, 255, 0.16);
            --shadow: 0 24px 80px rgba(0,0,0,.25);
        }
        html { scroll-behavior: smooth; }
        body {
            min-height: 100vh;
            background: radial-gradient(circle at top left, rgba(29,107,255,.14), transparent 24%),
                        radial-gradient(circle at right, rgba(77, 204, 255, .08), transparent 18%),
                        linear-gradient(180deg, #090e1f 0%, #060915 100%);
            color: var(--text);
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
        }
        a { color: inherit; text-decoration: none; }
        button { font-family: inherit; }
        img { max-width: 100%; display: block; }
        .container-fluid { max-width: 1300px; margin: 0 auto; }
        .sidebar {
            position: fixed;
            inset: 0 auto 0 0;
            width: 84px;
            background: rgba(9, 14, 31, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-right: 1px solid rgba(29, 107, 255, 0.16);
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 24px 0;
            z-index: 1000;
            gap: 20px;
            box-shadow: 4px 0 30px rgba(0, 0, 0, 0.25);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .sidebar-logo {
            width: 56px;
            height: 56px;
            border-radius: 18px;
            background: linear-gradient(135deg, #1d6bff, #4d94ff);
            display: grid;
            place-items: center;
            font-size: 1.45rem;
            font-weight: 800;
            color: white;
            box-shadow: 0 10px 25px rgba(29, 107, 255, 0.3);
            position: relative;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .sidebar-logo:hover {
            transform: rotate(8deg) scale(1.05);
            box-shadow: 0 15px 30px rgba(29, 107, 255, 0.45);
        }
        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin-top: 15px;
            width: 100%;
            align-items: center;
        }
        .sidebar-nav a {
            width: 54px;
            height: 54px;
            display: grid;
            place-items: center;
            border-radius: 16px;
            color: var(--muted);
            font-size: 1.15rem;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            border: 1px solid transparent;
            position: relative;
        }
        .sidebar-nav a::before {
            content: attr(data-title);
            position: absolute;
            left: 74px;
            background: rgba(16, 28, 54, 0.95);
            border: 1px solid rgba(29, 107, 255, 0.2);
            color: #ffffff;
            font-size: 0.78rem;
            font-weight: 600;
            padding: 6px 12px;
            border-radius: 8px;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transform: translateX(-10px);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            z-index: 1001;
        }
        .sidebar-nav a:hover::before {
            opacity: 1;
            transform: translateX(0);
        }
        .sidebar-nav a::after {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%) scaleY(0);
            width: 4px;
            height: 20px;
            background: var(--primary);
            border-radius: 0 4px 4px 0;
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 0 10px var(--primary);
        }
        .sidebar-nav a.active::after {
            transform: translateY(-50%) scaleY(1);
        }
        .sidebar-nav a.active,
        .sidebar-nav a:hover {
            color: #ffffff;
            border-color: rgba(29, 107, 255, 0.3);
            background: linear-gradient(135deg, rgba(29, 107, 255, 0.18) 0%, rgba(29, 107, 255, 0.05) 100%);
            box-shadow: 0 4px 15px rgba(29, 107, 255, 0.15);
        }
        .sidebar-nav a:hover {
            transform: translateX(2px);
        }
        .sidebar-action {
            margin-top: auto;
            width: 100%;
            display: grid;
            place-items: center;
        }
        .action-button {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: var(--primary);
            display: grid;
            place-items: center;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
        }
        .action-button::before {
            content: attr(data-title);
            position: absolute;
            left: 74px;
            background: rgba(16, 28, 54, 0.95);
            border: 1px solid rgba(29, 107, 255, 0.2);
            color: #ffffff;
            font-size: 0.78rem;
            font-weight: 600;
            padding: 6px 12px;
            border-radius: 8px;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transform: translateX(-10px);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            z-index: 1001;
        }
        .action-button:hover::before {
            opacity: 1;
            transform: translateX(0);
        }
        .action-button:hover {
            background: linear-gradient(135deg, var(--primary) 0%, #4d94ff 100%);
            border-color: transparent;
            color: white;
            transform: rotate(-8deg) scale(1.08);
            box-shadow: 0 10px 20px rgba(29, 107, 255, 0.25);
        }
        .main-content {
            margin-left: 84px;
            width: calc(100% - 84px);
        }
        section {
            padding: 100px 80px;
            position: relative;
            overflow: hidden;
            opacity: 0;
            transform: translateY(24px);
            transition: opacity .75s ease, transform .75s ease;
        }
        section.visible {
            opacity: 1;
            transform: translateY(0);
        }
        section::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at top left, rgba(29,107,255,.07), transparent 24%),
                        radial-gradient(circle at bottom right, rgba(77,204,255,.05), transparent 18%);
            pointer-events: none;
        }
        .section-intro {
            position: relative;
            z-index: 1;
            max-width: 720px;
            margin-bottom: 40px;
        }
        .section-intro h4 {
            letter-spacing: 1.8px;
            color: var(--primary);
            text-transform: uppercase;
            font-size: .9rem;
            margin-bottom: 18px;
        }
        .section-intro h2 {
            font-size: clamp(2.5rem, 2.4vw, 4rem);
            line-height: 1.05;
            margin-bottom: 0;
            font-weight: 800;
        }
        .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 40px; align-items: center; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 30px; }
        .grid-4 { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 30px; }
        .card {
            background: rgba(16, 28, 54, 0.92);
            border: 1px solid rgba(29,107,255,0.1);
            border-radius: 24px;
            box-shadow: var(--shadow);
            overflow: hidden;
            position: relative;
            transition: transform .3s ease, border-color .3s ease;
        }
        .card:hover { transform: translateY(-10px); border-color: rgba(29,107,255,0.2); }
        .card-body {
            padding: 32px;
            position: relative;
            z-index: 1;
        }
        .badge-soft {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            border-radius: 999px;
            background: rgba(29,107,255,.08);
            color: var(--primary);
            font-weight: 600;
            font-size: .95rem;
        }
        .badge-hero {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 20px;
            border-radius: 999px;
            background: rgba(29, 107, 255, 0.08);
            border: 1px solid rgba(29, 107, 255, 0.3);
            color: #60a5fa;
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1.8px;
            margin-bottom: 24px;
            box-shadow: 0 0 25px rgba(29, 107, 255, 0.15);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            animation: pulse-border 3s infinite;
        }
        @keyframes pulse-border {
            0%, 100% { border-color: rgba(29, 107, 255, 0.3); box-shadow: 0 0 15px rgba(29, 107, 255, 0.05); }
            50% { border-color: rgba(29, 107, 255, 0.6); box-shadow: 0 0 30px rgba(29, 107, 255, 0.25); }
        }
        .hero-title {
            font-size: clamp(3rem, 5.8vw, 5.2rem);
            line-height: 1.05;
            font-weight: 800;
            letter-spacing: -2px;
            margin-bottom: 24px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #ffffff;
        }
        .text-gradient-primary {
            background: linear-gradient(135deg, #ffffff 10%, #cbd5e1 60%, #94a3b8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: inline-block;
        }
        .text-gradient-accent {
            font-family: 'Outfit', sans-serif;
            background: linear-gradient(135deg, #00f2fe 0%, #3b82f6 35%, #a855f7 70%, #ff007f 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: inline-block;
            font-weight: 900;
            letter-spacing: -1px;
            filter: drop-shadow(0 2px 20px rgba(0, 242, 254, 0.35)) drop-shadow(0 4px 40px rgba(168, 85, 247, 0.25));
        }
        .hero-copy {
            max-width: 680px;
            font-family: 'Space Grotesk', sans-serif;
            color: #f1f5f9;
            font-size: 1.15rem;
            font-weight: 400;
            line-height: 2.0;
            margin-bottom: 36px;
            letter-spacing: 0.1px;
            opacity: 0.95;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
        }
        .hero-copy .tech-highlight {
            color: #60a5fa;
            font-weight: 700;
            border-bottom: 2px dashed rgba(29, 107, 255, 0.4);
            padding-bottom: 2px;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .hero-copy .tech-highlight:hover {
            color: #ffffff;
            border-bottom-color: var(--primary);
            background: rgba(29, 107, 255, 0.15);
            border-radius: 6px;
            padding-left: 8px;
            padding-right: 8px;
        }
        .typed-text {
            display: inline-block;
            font-family: 'Outfit', sans-serif;
            background: linear-gradient(135deg, #00f2fe 0%, #3b82f6 50%, #ff007f 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 800;
            min-width: 270px;
            text-align: left;
            white-space: nowrap;
            vertical-align: bottom;
            transition: min-width 0.3s ease;
        }
        @media (max-width: 768px) {
            .typed-text {
                min-width: auto;
                white-space: normal;
                display: inline;
            }
        }
        .hero-actions { display: flex; flex-wrap: wrap; gap: 18px; align-items: center; }
        .chatbot-panel { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); border-radius: 28px; padding: 32px; display: grid; gap: 24px; }
        .chatbot-res { min-height: 220px; padding: 24px; background: rgba(29,107,255,.06); border-radius: 22px; border: 1px solid rgba(29,107,255,.12); color: var(--text); overflow-wrap: anywhere; white-space: pre-wrap; }
        .chatbot-placeholder { color: var(--muted); }
        .chatbot-bubble { border-radius: 22px; padding: 20px; margin-bottom: 18px; }
        .chatbot-bubble.user { background: rgba(29,107,255,.15); border: 1px solid rgba(29,107,255,.18); }
        .chatbot-bubble.ai { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.12); }
        .assist-button {
            position: fixed;
            right: 24px;
            bottom: 24px;
            z-index: 1100;
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1d6bff, #4d94ff);
            color: white;
            display: grid;
            place-items: center;
            box-shadow: 0 22px 50px rgba(29,107,255,.28);
            border: 1px solid rgba(255,255,255,.18);
            text-decoration: none;
            transition: transform .25s ease, box-shadow .25s ease, background .25s ease;
            animation: pulse 2.2s ease-in-out infinite;
        }
        .assist-button:hover {
            transform: translateY(-4px);
            box-shadow: 0 26px 60px rgba(29,107,255,.35);
            background: linear-gradient(135deg, #4d94ff, #1d6bff);
        }
        .chat-popup {
            position: fixed;
            bottom: 24px;
            right: 24px;
            width: 340px;
            max-width: calc(100% - 32px);
            background: rgba(10,22,40,.98);
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 24px;
            box-shadow: 0 30px 100px rgba(0,0,0,.28);
            overflow: hidden;
            opacity: 0;
            visibility: hidden;
            transform: translateY(20px) scale(.98);
            transition: opacity .25s ease, transform .25s ease, visibility .25s ease;
            z-index: 1102;
        }
        .chat-popup.open {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }
        .chat-popup-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 18px 20px;
            background: rgba(255,255,255,.06);
            border-bottom: 1px solid rgba(255,255,255,.08);
        }
        .chat-popup-header h4 {
            margin: 0;
            font-size: 1rem;
            letter-spacing: .8px;
            color: white;
        }
        .chat-popup-body {
            padding: 18px;
            max-height: 280px;
            overflow-y: auto;
            display: grid;
            gap: 12px;
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.16) transparent;
        }
        .chat-popup-body::-webkit-scrollbar {
            width: 6px;
        }
        .chat-popup-body::-webkit-scrollbar-track {
            background: transparent;
        }
        .chat-popup-body::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,.16);
            border-radius: 999px;
        }
        .chat-popup-message {
            width: fit-content;
            max-width: 100%;
            padding: 14px 16px;
            border-radius: 18px;
            line-height: 1.6;
            word-break: break-word;
            font-size: .95rem;
        }
        .chat-popup-message.user {
            background: rgba(29,107,255,.18);
            border: 1px solid rgba(29,107,255,.25);
            justify-self: end;
        }
        .chat-popup-message.ai {
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.12);
            justify-self: start;
        }
        .chat-popup-message.ai ul,
        .chat-popup-message.ai ol {
            margin: 8px 0 0 16px;
            padding-left: 16px;
        }
        .chat-popup-form {
            position: relative;
            padding: 16px;
            border-top: 1px solid rgba(255,255,255,.08);
            background: rgba(255,255,255,.01);
        }
        .chat-input-wrapper {
            position: relative;
            width: 100%;
        }
        .chat-popup-form textarea {
            width: 100%;
            min-height: 54px;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,.12);
            background: rgba(255,255,255,.06);
            color: var(--text);
            padding: 14px 54px 14px 18px;
            resize: none;
            font-size: .95rem;
            line-height: 1.4;
        }
        .chat-popup-form button {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            width: 46px;
            height: 46px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            border: none;
            background: linear-gradient(135deg,#4d94ff,#1d6bff);
            color: white;
            box-shadow: 0 14px 28px rgba(29,107,255,.28);
            transition: transform .25s ease, box-shadow .25s ease, background .25s ease;
            cursor: pointer;
        }
        .chat-popup-form button:hover {
            transform: translateY(-50%) scale(1.1);
            box-shadow: 0 20px 42px rgba(29,107,255,.32);
            background: linear-gradient(135deg,#3f8bff,#1f63ff);
        }
        .chat-popup-form button i {
            margin: 0;
            font-size: 1rem;
        }
        .chat-popup-form textarea::placeholder {
            color: rgba(234,234,240,.65);
        }
        @media (max-width: 720px) {
            .chat-popup {
                right: 12px;
                bottom: 12px;
                width: min(92vw, 340px);
            }
            .chat-popup-body {
                max-height: 240px;
            }
        }
        .assist-button:hover {
            transform: translateY(-4px);
            box-shadow: 0 26px 60px rgba(29,107,255,.35);
            background: linear-gradient(135deg, #4d94ff, #1d6bff);
        }
        .assist-button i {
            font-size: 1.35rem;
        }
        @keyframes pulse {
            0%, 100% { transform: translateY(0) scale(1); box-shadow: 0 22px 50px rgba(29,107,255,.28); }
            50% { transform: translateY(-3px) scale(1.03); box-shadow: 0 28px 64px rgba(29,107,255,.32); }
        }
        .btn-primary { 
            display: inline-flex; 
            align-items: center; 
            gap: 12px; 
            border-radius: 999px; 
            padding: 16px 36px; 
            border: none; 
            background: linear-gradient(135deg, #1d6bff 0%, #3b82f6 50%, #60a5fa 100%); 
            color: white; 
            font-weight: 700; 
            letter-spacing: 0.5px;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 10px 25px rgba(29, 107, 255, 0.25);
        }
        .btn-primary:hover { 
            transform: translateY(-4px); 
            box-shadow: 0 20px 40px rgba(29, 107, 255, 0.45), 0 0 25px rgba(29, 107, 255, 0.2); 
            color: #ffffff;
        }
        .btn-secondary { 
            display: inline-flex; 
            align-items: center; 
            gap: 12px; 
            color: #ffffff; 
            border: 1px solid rgba(29, 107, 255, 0.3); 
            padding: 15px 32px; 
            border-radius: 999px; 
            background: rgba(29, 107, 255, 0.05); 
            font-weight: 600;
            letter-spacing: 0.5px;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .btn-secondary:hover {
            background: rgba(29, 107, 255, 0.15);
            border-color: rgba(29, 107, 255, 0.6);
            color: #ffffff;
            transform: translateY(-4px);
            box-shadow: 0 15px 30px rgba(29, 107, 255, 0.15);
        }
        .hero-details { 
            display: grid; 
            grid-template-columns: repeat(2, minmax(0, 1fr)); 
            gap: 20px; 
            margin-top: 48px; 
        }
        .hero-card { 
            background: linear-gradient(135deg, rgba(16, 28, 54, 0.5) 0%, rgba(9, 14, 31, 0.8) 100%); 
            border: 1px solid rgba(29, 107, 255, 0.18); 
            border-radius: 24px; 
            padding: 26px 30px; 
            transition: all 0.45s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
            box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.08), 0 12px 30px rgba(0, 0, 0, 0.35);
        }
        .hero-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at center, rgba(29, 107, 255, 0.15) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.45s ease;
            pointer-events: none;
        }
        .hero-card:hover {
            transform: translateY(-6px) scale(1.02);
            border-color: rgba(29, 107, 255, 0.5);
            box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.15), 
                        0 24px 48px rgba(0, 0, 0, 0.45), 
                        0 0 30px rgba(29, 107, 255, 0.25);
            background: linear-gradient(135deg, rgba(16, 28, 54, 0.7) 0%, rgba(9, 14, 31, 0.95) 100%);
        }
        .hero-card:hover::before {
            opacity: 1;
        }
        .hero-card strong { 
            display: flex; 
            align-items: center; 
            gap: 12px;
            font-size: 2.6rem; 
            font-weight: 800;
            color: #ffffff; 
            line-height: 1; 
            font-family: 'Plus Jakarta Sans', sans-serif;
            position: relative;
            z-index: 2;
        }
        .hero-card strong i {
            font-size: 1.6rem;
            color: #38bdf8;
            opacity: 0.9;
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .hero-card:hover strong i {
            transform: scale(1.25) rotate(8deg);
            color: #ffffff;
            filter: drop-shadow(0 0 12px rgba(56, 189, 248, 0.8));
        }
        .hero-card span { 
            display: block; 
            margin-top: 10px; 
            color: #a8b2d1; 
            font-size: 0.92rem;
            font-weight: 600;
            letter-spacing: 0.4px;
            position: relative;
            z-index: 2;
            transition: color 0.3s ease;
        }
        .hero-card:hover span {
            color: #ffffff;
        }
        .social-list { 
            display: flex; 
            gap: 16px; 
            margin-top: 36px; 
        }
        .social-list a { 
            width: 50px; 
            height: 50px; 
            border-radius: 16px; 
            display: grid; 
            place-items: center; 
