<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Projects | Usman Ahmad</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --primary: #1d6bff;
            --primary-soft: rgba(29, 107, 255, 0.15);
            --background: #090e1f;
            --surface: #111a36;
            --surface-strong: #131f44;
            --text: #eaeaf0;
            --muted: #8f96aa;
            --border: rgba(29, 107, 255, 0.16);
            --shadow: 0 24px 80px rgba(0,0,0,.25);
        }
        body {
            min-height: 100vh;
            background: radial-gradient(circle at top left, rgba(29,107,255,.14), transparent 24%),
                        radial-gradient(circle at right, rgba(77, 204, 255, .08), transparent 18%),
                        linear-gradient(180deg, #090e1f 0%, #060915 100%);
            color: var(--text);
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
            padding-bottom: 80px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px;
        }
        
        /* Header / Navbar */
        .page-header {
            padding: 40px 0;
            border-bottom: 1px solid rgba(29, 107, 255, 0.12);
            margin-bottom: 50px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--text);
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 500;
            padding: 10px 20px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(29, 107, 255, 0.2);
            border-radius: 12px;
            transition: all 0.3s ease;
        }
        .btn-back:hover {
            background: rgba(29, 107, 255, 0.15);
            border-color: #00f2fe;
            color: #00f2fe;
            transform: translateX(-4px);
            box-shadow: 0 0 20px rgba(0, 242, 254, 0.2);
        }

        /* Intro Section */
        .intro-title {
            font-family: 'Outfit', sans-serif;
            font-size: 3rem;
            font-weight: 900;
            background: linear-gradient(135deg, #00f2fe 0%, #3b82f6 50%, #a855f7 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 15px;
            letter-spacing: -1px;
            filter: drop-shadow(0 2px 20px rgba(0, 242, 254, 0.15));
        }
        .intro-subtitle {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.15rem;
            color: var(--muted);
            max-width: 600px;
            line-height: 1.7;
        }

        /* Category Filter Badges */
        .filter-container {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 40px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        .filter-btn {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(29, 107, 255, 0.15);
            color: var(--muted);
            padding: 8px 18px;
            border-radius: 30px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 500;
            font-family: 'Space Grotesk', sans-serif;
            transition: all 0.3s ease;
        }
        .filter-btn:hover {
            background: rgba(29, 107, 255, 0.1);
            color: white;
            border-color: rgba(29, 107, 255, 0.4);
        }
        .filter-btn.active {
            background: linear-gradient(135deg, #1d6bff 0%, #00f2fe 100%);
            color: #090e1f;
            font-weight: 600;
            border-color: transparent;
            box-shadow: 0 4px 15px rgba(0, 242, 254, 0.25);
        }

        /* Portfolio Grid & Cards */
        .projects-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 30px;
        }
        @media (max-width: 992px) {
            .projects-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }
        @media (max-width: 768px) {
            .projects-grid {
                grid-template-columns: repeat(1, minmax(0, 1fr));
            }
        }

        /* Card Custom Styling */
        .project-card {
            background: rgba(17, 26, 54, 0.4);
            border: 1px solid rgba(29, 107, 255, 0.15);
            border-radius: 24px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            height: 100%;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }
        .project-card:hover {
            transform: translateY(-8px);
            border-color: rgba(0, 242, 254, 0.4);
            background: rgba(17, 26, 54, 0.85);
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.3), 0 0 30px rgba(29, 107, 255, 0.15);
        }
        .card-img-wrap {
            position: relative;
            overflow: hidden;
            aspect-ratio: 16/10;
            background: #090e1f;
        }
        .card-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .project-card:hover .card-img-wrap img {
            transform: scale(1.08);
        }

        /* Glowing Overlay & Button */
        .card-overlay {
            position: absolute;
            inset: 0;
            background: rgba(9, 14, 31, 0.85);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            opacity: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: opacity 0.4s ease;
            z-index: 2;
        }
        .project-card:hover .card-overlay {
            opacity: 1;
        }
        .btn-view-project {
            background: linear-gradient(135deg, #00f2fe 0%, #3b82f6 100%);
            color: #090e1f;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            padding: 12px 28px;
            border-radius: 14px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transform: translateY(20px);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 4px 20px rgba(0, 242, 254, 0.4);
            cursor: pointer;
            text-decoration: none;
        }
        .project-card:hover .btn-view-project {
            transform: translateY(0);
        }
        .btn-view-project:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 25px rgba(0, 242, 254, 0.6);
            color: #090e1f;
        }

        /* Card Content */
        .card-body-custom {
            padding: 24px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }
        .project-category {
            font-family: 'Space Grotesk', sans-serif;
            color: #00f2fe;
            font-size: 0.78rem;
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 1.5px;
            margin-bottom: 10px;
        }
        .project-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: white;
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 12px;
            line-height: 1.4;
            transition: color 0.3s ease;
        }
        .project-card:hover .project-title {
            color: #00f2fe;
        }
        .project-desc {
            font-size: 0.92rem;
            color: var(--muted);
            line-height: 1.7;
            margin-bottom: 20px;
            flex-grow: 1;
        }
        .tag-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: auto;
        }
        .tag-item {
            background: rgba(29, 107, 255, 0.1);
            color: #60a5fa;
            font-size: 0.72rem;
            padding: 4px 10px;
            border-radius: 6px;
            font-weight: 500;
            font-family: 'Space Grotesk', sans-serif;
            border: 1px solid rgba(29, 107, 255, 0.15);
        }

        /* Skills highlight prominent area */
        .skills-heading-container {
            margin-top: 40px;
            margin-bottom: 30px;
            text-align: left;
        }
        .skills-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 15px;
        }
        .skill-pill {
            background: linear-gradient(135deg, rgba(29, 107, 255, 0.06), rgba(0, 242, 254, 0.03));
            border: 1.5px solid rgba(0, 242, 254, 0.2);
            color: #eaeaf0;
            padding: 8px 16px;
            border-radius: 50px;
            font-size: 0.82rem;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 600;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
        }
        .skill-pill:hover {
            border-color: #00f2fe;
            transform: scale(1.05);
            box-shadow: 0 4px 20px rgba(0, 242, 254, 0.25);
            color: #00f2fe;
        }
        .skill-pill i {
            font-size: 0.95rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Page Header -->
        <header class="page-header">
            <a href="/" class="btn-back">
                <i class="fas fa-arrow-left"></i> Back to Portfolio
            </a>
            <div style="font-family: 'Space Grotesk', sans-serif; font-size: 0.9rem; color: #00f2fe; font-weight: 600; letter-spacing: 1px;">
                <i class="fas fa-terminal"></i> portfolio_viewer.sh
            </div>
        </header>

        <!-- Main Title & Desc -->
        <section class="mb-5 animate__animated animate__fadeIn">
            <h1 class="intro-title">All Project Showcases</h1>
            <p class="intro-subtitle">
                Explore my production-ready backend systems, dynamic user interfaces, secure database configurations, and admin controls.
            </p>
            
            <!-- Prominent Skills Heading Below -->
            <div class="skills-heading-container">
                <span class="text-uppercase" style="font-size: 0.75rem; letter-spacing: 2px; color: var(--muted); font-weight: 700;">PROMINENT ENGINEERING EXPERTISE</span>
                <div class="skills-pills">
                    <span class="skill-pill"><i class="fab fa-python" style="color: #ffd43b;"></i> Python</span>
                    <span class="skill-pill"><i class="fas fa-server" style="color: #449d44;"></i> Django</span>
                    <span class="skill-pill"><i class="fas fa-project-diagram" style="color: #00f2fe;"></i> REST APIs (DRF)</span>
                    <span class="skill-pill"><i class="fas fa-sliders-h" style="color: #38bdf8;"></i> Admin Dashboard Controlling</span>
                    <span class="skill-pill"><i class="fab fa-react" style="color: #60a5fa;"></i> React.js</span>
                    <span class="skill-pill"><i class="fas fa-bolt" style="color: #3ecf8e;"></i> Supabase</span>
                    <span class="skill-pill"><i class="fas fa-fire" style="color: #ffca28;"></i> Firebase</span>
                </div>
            </div>
        </section>

        <!-- Category Filters -->
        <div class="filter-container animate__animated animate__fadeIn" style="animation-delay: 0.1s;">
            <button class="filter-btn active" onclick="filterCategory('all')">All Engineering (<%= projects.length %>)</button>
            <button class="filter-btn" onclick="filterCategory('Backend Development')">Backend Development</button>
            <button class="filter-btn" onclick="filterCategory('Dashboard Controlling')">Dashboard Controlling</button>
            <button class="filter-btn" onclick="filterCategory('System Integration')">System Integration</button>
            <button class="filter-btn" onclick="filterCategory('Cloud Database Integration')">Cloud Integration</button>
        </div>

        <!-- Project Grid -->
        <div class="projects-grid animate__animated animate__fadeIn" style="animation-delay: 0.2s;">
            <% if (projects && projects.length > 0) { %>
                <% projects.forEach(function(p, i) { %>
                    <article class="project-card" data-category="<%= p.category %>" style="animation-delay: <%= (i * 0.1) %>s;">
                        <div class="card-img-wrap">
                            <% if (p.image) { %>
                                <img src="<%= p.image %>" onerror="this.onerror=null; <% if (p.fallback_image) { %>this.src='<%= p.fallback_image %>';<% } %>" alt="<%= p.title %>">
                            <% } else { %>
                                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(29,107,255,.22), rgba(77,204,255,.12));">
                                    <i class="fas fa-image fa-3x" style="opacity:.6;"></i>
                                </div>
                            <% } %>
                            
                            <!-- Hover View Button Overlay -->
                            <div class="card-overlay">
                                <button class="btn-view-project" onclick="openDetailsModal('<%= p.id %>')">
                                    <i class="fas fa-external-link-alt"></i> View Project
                                </button>
                            </div>
                        </div>
                        <div class="card-body-custom">
                            <span class="project-category"><%= p.category %></span>
                            <h3 class="project-title"><%= p.title %></h3>
                            <p class="project-desc"><%= p.description %></p>
                            
                            <% if (p.tags && p.tags.length > 0) { %>
                                <div class="tag-list">
                                    <% p.tags.forEach(function(tag) { 
                                        var tagLower = tag.toLowerCase();
                                        var style = "font-size: 0.72rem; padding: 5px 12px; border-radius: 8px; font-weight: 600; font-family: 'Space Grotesk', sans-serif; transition: all 0.3s ease;";
                                        if (tagLower.includes('django') || tagLower.includes('python')) {
                                            style += " background: rgba(16, 185, 129, 0.12); color: #10b981; border: 1.5px solid rgba(16, 185, 129, 0.3);";
                                        } else if (tagLower.includes('react') || tagLower.includes('tailwind') || tagLower.includes('dashboard') || tagLower.includes('control')) {
                                            style += " background: rgba(0, 242, 254, 0.12); color: #00f2fe; border: 1.5px solid rgba(0, 242, 254, 0.3);";
                                        } else if (tagLower.includes('rest') || tagLower.includes('jwt') || tagLower.includes('cors')) {
                                            style += " background: rgba(168, 85, 247, 0.12); color: #a855f7; border: 1.5px solid rgba(168, 85, 247, 0.3);";
                                        } else if (tagLower.includes('websocket') || tagLower.includes('redis') || tagLower.includes('channels') || tagLower.includes('real-time')) {
                                            style += " background: rgba(245, 158, 11, 0.12); color: #fb923c; border: 1.5px solid rgba(245, 158, 11, 0.3);";
                                        } else if (tagLower.includes('supabase') || tagLower.includes('postgres') || tagLower.includes('db')) {
                                            style += " background: rgba(62, 207, 142, 0.12); color: #3ecf8e; border: 1.5px solid rgba(62, 207, 142, 0.3);";
                                        } else if (tagLower.includes('firebase') || tagLower.includes('auth') || tagLower.includes('firestore') || tagLower.includes('secure')) {
                                            style += " background: rgba(251, 191, 36, 0.12); color: #fbbf24; border: 1.5px solid rgba(251, 191, 36, 0.3);";
                                        } else {
                                            style += " background: rgba(29, 107, 255, 0.12); color: #60a5fa; border: 1.5px solid rgba(29, 107, 255, 0.3);";
                                        }
                                    %>
                                        <span style="<%= style %>"><%= tag %></span>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>
                    </article>
                <% }) %>
            <% } else { %>
                <div class="text-center py-5" style="grid-column: 1 / -1;">
                    <p class="text-muted">No projects found.</p>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Bootstrap details Modal -->
    <div class="modal fade" id="projectDetailsModal" tabindex="-1" aria-labelledby="projectDetailsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" style="background: #111a36; border: 1px solid rgba(29, 107, 255, 0.25); border-radius: 20px; color: #eaeaf0;">
                <div class="modal-header" style="border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                    <h5 class="modal-title font-family-outfit fw-bold" id="projectDetailsModalLabel" style="color: #00f2fe;">Project Core Information</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="modalProjectBody">
                    <!-- Dynamic details are injected here -->
                </div>
                <div class="modal-footer" style="border-top: 1px solid rgba(255, 255, 255, 0.08);">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius: 10px; font-family: 'Space Grotesk', sans-serif;">Close Details</button>
                    <a id="modalActionBtn" href="/#contact" class="btn btn-primary" style="background: #1d6bff; border: none; border-radius: 10px; font-family: 'Space Grotesk', sans-serif;">Discuss Integration</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripting for filters and details -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const projectData = <%- JSON.stringify(projects) %>;

        function filterCategory(cat) {
            // Update active state of buttons
            const buttons = document.querySelectorAll('.filter-btn');
            buttons.forEach(btn => btn.classList.remove('active'));
            event.currentTarget.classList.add('active');

            // Filter items
            const items = document.querySelectorAll('.project-card');
            items.forEach(item => {
                const category = item.getAttribute('data-category');
                if (cat === 'all' || category === cat) {
                    item.style.display = 'flex';
                    item.classList.add('animate__fadeIn');
                } else {
                    item.style.display = 'none';
                    item.classList.remove('animate__fadeIn');
                }
            });
        }

        function openDetailsModal(id) {
            const project = projectData.find(p => p.id == id);
            if (!project) return;

            const modalBody = document.getElementById('modalProjectBody');
            
            let tagsHtml = '';
            if (project.tags && project.tags.length > 0) {
                tagsHtml = `<div class="mt-3">
                    <strong>Technologies Used:</strong>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        ${project.tags.map(t => `<span class="badge" style="background: rgba(29, 107, 255, 0.2); color: #00f2fe; border: 1px solid rgba(29, 107, 255, 0.4); padding: 6px 12px; font-size: 0.8rem; border-radius: 8px;">${t}</span>`).join('')}
                    </div>
                </div>`;
            }

            modalBody.innerHTML = `
                <div class="row">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <img src="${project.image}" class="img-fluid rounded-3 mb-3" style="width:100%; object-fit:cover; aspect-ratio:16/10; border: 1px solid rgba(255, 255, 255, 0.1);" alt="${project.title}">
                    </div>
                    <div class="col-md-6 d-flex flex-column justify-content-between">
                        <div>
                            <span class="text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 1.5px; color: #00f2fe;">${project.category}</span>
                            <h4 class="fw-bold text-white mt-1 mb-3">${project.title}</h4>
                            <p style="color: #cbd5e1; font-size: 0.95rem; line-height: 1.7;">${project.description}</p>
                        </div>
                        ${tagsHtml}
                    </div>
                </div>
            `;

            const modal = new bootstrap.Modal(document.getElementById('projectDetailsModal'));
            modal.show();

            // Link discussed action to close modal and go to contact form
            document.getElementById('modalActionBtn').addEventListener('click', function() {
                modal.hide();
            });
        }
    </script>
</body>
</html>
